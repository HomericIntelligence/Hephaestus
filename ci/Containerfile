# Containerfile for hephaestus-ci — CI image for shared HomericIntelligence tooling.
#
# This image provides:
# - Python 3.13 environment (matches requires-python >=3.13,<3.14)
# - uv with the locked project environment (all groups + extras) pre-installed
# - pre-commit hook environments baked in (largest speedup)
# - Non-root user 'ci' for rootless Podman compatibility
#
# Toolchain: uv (Odysseus ADR-017). Pattern mirrors Scylla ci/Containerfile.
#
# Git is built from a pinned kernel.org release into /usr/local. The pipeline's
# checkout isolation sets GIT_CONFIG_GLOBAL=/dev/null, and the automation code
# only trusts a real (non-symlink) Git binary under a trusted root. See issue
# #2821 and hephaestus/automation/worktree_snapshot.py. The image holds this one
# Git only: every tool that needs Git, including the GitHub CLI, uses it.
#
# Build (OCI-compliant — works with both podman and docker):
#   podman build --jobs=2 -f ci/Containerfile -t hephaestus-ci:local .
#   docker build -f ci/Containerfile -t hephaestus-ci:local .
#
# The stages are independent where they can be: the runtime package install and
# the builder dependency sync run while the pinned Git compiles. Podman needs
# --jobs to overlap them; Docker's BuildKit does this by default. Two jobs suit
# a four-core runner, where make -j inside the Git build already uses every
# core.
#
# Run:
#   podman run --rm -v .:/workspace:Z hephaestus-ci:local uv run pytest tests/unit
#   podman run --rm -v .:/workspace:Z hephaestus-ci:local uv run pre-commit run --all-files

# ============================================================================
# Stage 0: uv binary — installed from a pinned GitHub release so the checksum
# is reproducible and the build resolves identically under both podman/buildah
# and docker (no cross-registry COPY of a third-party image). The ghcr.io
# astral-sh/uv image's version-tag scheme does not track uv CLI versions
# (0.11.21 does not exist there), so we pin the release tarball instead.
# ============================================================================
ARG TARGETARCH
ARG DEBIAN_SNAPSHOT=20260701T000000Z
# Pinned Git source release. The SHA-256 is from the signed kernel.org
# checksum list: https://www.kernel.org/pub/software/scm/git/sha256sums.asc
ARG GIT_VERSION=2.49.0
ARG GIT_SHA256=618190cf590b7e9f6c11f91f23b1d267cd98c3ab33b850416d8758f8b5a85628

# All Python stages inherit immutable Debian package indexes. The base image is
# digest-pinned, and the dated snapshot fixes both package candidates and their
# signed artifacts so rebuilding does not resolve today's Debian repository.
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS python-snapshot

ARG DEBIAN_SNAPSHOT

RUN . /etc/os-release \
    && rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
    && printf '%s\n' \
        "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ ${VERSION_CODENAME} main" \
        "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ ${VERSION_CODENAME}-security main" \
        > /etc/apt/sources.list.d/debian-snapshot.list

FROM python-snapshot AS uv

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
        amd64) uv_asset="uv-x86_64-unknown-linux-gnu"; uv_sha256="90b2f223fb69d19db49e117da601f64978593417988530aa733d456141b4bcbb" ;; \
        arm64) uv_asset="uv-aarch64-unknown-linux-gnu"; uv_sha256="769d373e146692c639b5fbaae33b331c297a32e03d30448772051902df52bbf4" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 180 --connect-timeout 30 --max-time 300 "https://github.com/astral-sh/uv/releases/download/0.12.1/${uv_asset}.tar.gz" -o /tmp/uv.tar.gz \
    && echo "${uv_sha256}  /tmp/uv.tar.gz" | sha256sum --check \
    && tar xzf /tmp/uv.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /tmp/uv.tar.gz

# ============================================================================
# Stage: git-source — pinned Git built from source into /usr/local.
#
# Debian's Git is replaced so the image runs one exact, trusted Git. A source
# build under /usr/local gives a real binary (not a symlink) inside the trusted
# discovery root, so the automation allowlist selects it first.
# ============================================================================
FROM python-snapshot AS git-source

ARG GIT_VERSION
ARG GIT_SHA256

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gcc \
    gettext \
    libc6-dev \
    libcurl4-openssl-dev \
    libexpat1-dev \
    libpcre2-dev \
    libssl-dev \
    make \
    perl \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 180 --connect-timeout 30 --max-time 600 "https://www.kernel.org/pub/software/scm/git/git-${GIT_VERSION}.tar.xz" -o /tmp/git.tar.xz \
    && echo "${GIT_SHA256}  /tmp/git.tar.xz" | sha256sum --check \
    && mkdir -p /tmp/git-src \
    && tar xJf /tmp/git.tar.xz -C /tmp/git-src --strip-components=1 \
    && make -C /tmp/git-src -j"$(nproc)" prefix=/usr/local NO_TCLTK=YesPlease all \
    && make -C /tmp/git-src prefix=/usr/local NO_TCLTK=YesPlease install \
    && rm -rf /tmp/git-src /tmp/git.tar.xz \
    && test ! -L /usr/local/bin/git \
    && test "$(/usr/local/bin/git --version)" = "git version ${GIT_VERSION}" \
    && test -x /usr/local/libexec/git-core/git-remote-http \
    && for binary in /usr/local/bin/git /usr/local/libexec/git-core/*; do \
        if [ -f "$binary" ] && [ "$(od -An -tx1 -N4 "$binary" | tr -d ' \n')" = "7f454c46" ]; then \
            if ldd "$binary" 2>&1 | grep -q 'not found'; then \
                echo "unresolved shared library for $binary" >&2; ldd "$binary" >&2; exit 1; \
            fi; \
        fi; \
    done

# ============================================================================
# Stage: node — pinned Node 22 runtime for the Pi coding-agent CLI used by the
# Pi package bootstrap and smoke tests.
# ============================================================================
FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS node

# Pre-install the Pi CLI here so the runtime stage can copy the whole /usr/local
# prefix in one consistent tree (copying node/npm/npx individually breaks npm's
# internal relative requires). The managed package set is installed in the
# final runtime stage after the project virtualenv has been copied in.
COPY hephaestus/agents/pi_package_catalog.json /tmp/pi_package_catalog.json
RUN pi_spec="$(node -e 'const p=require("/tmp/pi_package_catalog.json").compatibility.pi; process.stdout.write(`${p.npm_name}@${p.version}`)')" && \
    npm install -g --ignore-scripts "$pi_spec" && \
    pi --version

# ============================================================================
# Stage 1: Builder — install uv and the locked project environment
#
# The dependency sync needs Git: the automation extra depends on the
# homericintelligence-agamemnon source package, which uv clones over Git. The
# pinned Git above is therefore a prerequisite of this stage, not a parallel
# stage.
# ============================================================================
FROM python-snapshot AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Build the project virtualenv in a fixed, copyable location.
    UV_PROJECT_ENVIRONMENT=/opt/hephaestus-venv \
    # Bytecode-compile on install for faster cold starts.
    UV_COMPILE_BYTECODE=1 \
    # Copy (not hardlink) from the cache so the venv is self-contained for the
    # runtime-stage COPY --from=builder.
    UV_LINK_MODE=copy \
    # Keep the absolute repository paths in the pre-commit database valid when
    # the runtime stage copies the cache.
    PRE_COMMIT_HOME=/opt/pre-commit-cache \
    PATH="/opt/hephaestus-venv/bin:/usr/local/bin:$PATH"

# Install build dependencies from the immutable Debian snapshot configured by
# python-snapshot. Git is not installed here: the git-source stage supplies the
# pinned binary that the dependency sync and pre-commit hooks run.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pinned release — keep the version and sha256 in sync with
# astral-sh/setup-uv in .github/workflows/*.yml when bumping).
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Prepare hooks with the same pinned Node/npm prefix used by the runtime.
# Both stages must select the same pre-commit system Node environment.
COPY --from=node /usr/local/ /usr/local/

# Pinned Git binary for the pre-commit hooks and the synthetic repository below.
COPY --from=git-source /usr/local/ /usr/local/

# Layer 1: Dependency files + the package source the hatchling build needs.
# The package tree is copied so `uv sync` can install the project itself,
# mirroring `uv sync --all-groups --all-extras --locked` in CI. Layer stays
# cached when only the lock/config files change; uv's own cache absorbs the
# dependency downloads, so source-only edits rebuild this layer quickly.
WORKDIR /opt/hephaestus-build
COPY uv.lock pyproject.toml .pre-commit-config.yaml README.md ./
COPY hephaestus/ hephaestus/

# Layer 2: Install the locked dependency set (all groups + extras) plus the
# project itself into the venv, exactly as CI does.
# hatch-vcs derives the package version from git tags, so init a synthetic
# repo with a base tag first; pre-commit install-hooks also needs a git repo.
# The synthetic .git is removed at the end of this stage.
RUN git init . && \
    git -c user.email=ci@localhost -c user.name=ci commit --allow-empty --quiet -m base && \
    git tag 0.0.0 && \
    uv sync --all-groups --all-extras --locked --no-editable

# Layer 3: Install pre-commit hook environments.
# Baking this in means 'pre-commit run --all-files' starts immediately,
# without downloading hook repos or creating virtualenvs at CI time.
RUN uv run --no-sync pre-commit install-hooks && \
    rm -rf .git

# ============================================================================
# Stage 2: Runtime — minimal image without build tools
# ============================================================================
FROM python-snapshot

ARG TARGETARCH
ARG GIT_VERSION
ARG BATS_VERSION=1.11.1-1
ARG SHELLCHECK_VERSION=0.10.0-1

LABEL org.opencontainers.image.title="hephaestus-ci"
LABEL org.opencontainers.image.description="CI container for Hephaestus — validation, testing, security scans"
LABEL org.opencontainers.image.vendor="Hephaestus"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/Hephaestus"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/hephaestus-venv \
    UV_LINK_MODE=copy \
    PRE_COMMIT_HOME=/opt/pre-commit-cache \
    PATH="/opt/hephaestus-venv/bin:/usr/local/bin:$PATH"

# Runtime-only system packages (no build tools), resolved from the same
# immutable snapshot as the builder stage. No package-manager Git is installed:
# the pinned binary from the git-source stage is the only Git in the image, and
# the final assertions prove it. The remaining packages are the shared
# libraries and Perl runtime that the pinned binary and its helpers load.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bats="${BATS_VERSION}" \
    curl \
    ca-certificates \
    jq \
    liberror-perl \
    libcurl4t64 \
    libexpat1 \
    libpcre2-8-0 \
    libssl3t64 \
    openssh-client \
    perl \
    shellcheck="${SHELLCHECK_VERSION}" \
    util-linux \
    zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && test -x /usr/bin/unshare && test -x /usr/bin/setpriv && test -x /usr/bin/prlimit \
    && test "$(bats --version)" = "Bats 1.11.1" \
    && shellcheck --version | grep -Fx "version: 0.10.0"

# GitHub CLI (gh) — pinned release; native runners ship it preinstalled and the
# automation pipeline's _trusted_gh_executable() requires it. The release
# archive is installed, not the .deb: the .deb declares a dependency on the
# distribution Git, which this image must not carry. /usr/local/bin/gh is a
# trusted candidate in remote_git.py and worker_pool.py.
# Checksums: https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_checksums.txt
RUN case "$TARGETARCH" in \
        amd64) gh_arch="amd64"; gh_sha256="a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112" ;; \
        arm64) gh_arch="arm64"; gh_sha256="73ea440ecad9c9e284429997ee6f93577bc6f7bc6fba357ef62c53ad8fb641a5" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 180 --connect-timeout 30 --max-time 300 "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_linux_${gh_arch}.tar.gz" -o /tmp/gh.tar.gz \
    && echo "${gh_sha256}  /tmp/gh.tar.gz" | sha256sum --check \
    && tar xzf /tmp/gh.tar.gz -C /usr/local --strip-components=1 --no-same-owner "gh_2.97.0_linux_${gh_arch}/bin/gh" \
    && rm -f /tmp/gh.tar.gz \
    && test "$(command -v gh)" = "/usr/local/bin/gh" \
    && gh --version | grep -qx 'gh version 2.97.0.*'

# just — same release as the required justfile and shell-test jobs.
RUN case "$TARGETARCH" in \
        amd64) just_arch="x86_64"; just_sha256="bc7c9f377944f8de9cd0418b11d2955adebfa25a488c0b5e3dd2d2c0e9d732da" ;; \
        arm64) just_arch="aarch64"; just_sha256="bb3886b15e2cbcb9c0eb19956297d36de4eaef45b89d3f5fa5d1fc4ed3b5b51d" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 180 --connect-timeout 30 --max-time 300 "https://github.com/casey/just/releases/download/1.36.0/just-1.36.0-${just_arch}-unknown-linux-musl.tar.gz" -o /tmp/just.tar.gz \
    && echo "${just_sha256}  /tmp/just.tar.gz" | sha256sum --check \
    && tar xzf /tmp/just.tar.gz -C /usr/local/bin just \
    && rm -f /tmp/just.tar.gz

# Node 22 + npm + the Pi coding-agent CLI (same pin as setup-pi-cli), copied
# as one consistent /usr/local tree from the node stage.
COPY --from=node /usr/local/ /usr/local/

# Pinned source-built Git under /usr/local, so PATH and the automation trusted
# Git allowlist both select it instead of a Debian package binary.
COPY --from=git-source /usr/local/ /usr/local/

# Copy the uv binaries and the pre-installed project virtualenv from builder.
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
COPY --from=builder /opt/hephaestus-venv /opt/hephaestus-venv

# Create non-root user for rootless Podman compatibility
# UID 1000 is the default first user on most Linux systems, matching typical
# developer UIDs for smooth volume mount permissions without --userns=keep-id
RUN groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci

# Keep the cache at the same absolute path that the builder database records.
# Docker can use the host user ID, so all runtime users must be able to lock
# and update this disposable hook cache.
COPY --from=builder /opt/pre-commit-cache /opt/pre-commit-cache
RUN chown -R ci:ci /opt/pre-commit-cache && \
    chmod -R a+rwX /opt/pre-commit-cache

# Podman maps the ci user through keep-id and may refresh the editable install.
# Docker's arbitrary host UID uses the baked environment without syncing and
# imports project code from /workspace; the environment need not be world-writable.
RUN chown -R ci:ci /opt/hephaestus-venv

ENV HOME=/home/ci \
    PI_CODING_AGENT_DIR=/home/ci/.pi/agent

# Fail the build if the image cannot run the pinned Git: the correct binary on
# PATH, a real file rather than a symlink, its HTTP transport helper, complete
# shared-library resolution, and the Perl runtime its subcommands need.
RUN test "$(command -v git)" = "/usr/local/bin/git" \
    && test ! -e /usr/bin/git \
    && test ! -L /usr/local/bin/git \
    && test "$(git --version)" = "git version ${GIT_VERSION}" \
    && test -x /usr/local/libexec/git-core/git-remote-http \
    && for binary in /usr/local/bin/git /usr/local/libexec/git-core/*; do \
        if [ -f "$binary" ] && [ "$(od -An -tx1 -N4 "$binary" | tr -d ' \n')" = "7f454c46" ]; then \
            if ldd "$binary" 2>&1 | grep -q 'not found'; then \
                echo "unresolved shared library for $binary" >&2; ldd "$binary" >&2; exit 1; \
            fi; \
        fi; \
    done \
    && perl -MError -e 'print qq(ok\n)' \
    && mkdir -p /tmp/git-config-check \
    && printf '[credential]\n\thelper = !/unsafe/helper\n' > /tmp/git-config-check/.gitconfig \
    && test -z "$(HOME=/tmp/git-config-check GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git config --global --get credential.helper)" \
    && rm -rf /tmp/git-config-check

WORKDIR /home/ci

USER ci

RUN hephaestus-install-pi-plugins --global --yes --no-approve

# Working directory is the mounted repo root at runtime
WORKDIR /workspace

# No ENTRYPOINT — commands are provided externally by CI or run_ci_local.sh
# Example: podman run --rm -v .:/workspace:Z hephaestus-ci:local uv run pytest
